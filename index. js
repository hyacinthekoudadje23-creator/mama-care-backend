const express = require("express");
const app = express();

app.use(express.json());
app.use(express.urlencoded({ extended: true }));

app.use("/api", require("./itinéraires/api"));
app.use("/", require("./itinéraires/sms"));

app.get("/health", (req, res) => res.json({ status: "ok" }));

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`Serveur Mama Care lancé sur le port ${PORT}`));

module.exports = app;
